DATABASE_URL=postgres://forma:forma_local@127.0.0.1:5433/forma?sslmode=disable
HTTP_ADDRESS=127.0.0.1:8081
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
LOG_LEVEL=info
AUTO_MIGRATE=true

# Adapter interno: approved ou declined. Nunca recebido do navegador.
PAYMENT_SIMULATED_OUTCOME=approved

APP_ENV=development
ENABLE_API_DOCS=true
# Production: APP_ENV=production, AUTO_MIGRATE=false, ENABLE_API_DOCS=false
# Database TLS: sslmode=verify-full and non-default runtime credential.

# Mailpit local; no envio externo. Compose usa mailpit:1025.
SITE_ORIGIN=http://127.0.0.1:5173
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_TLS_MODE=none
SMTP_FROM=Forma <conta@localhost>
# Produção: SMTP_TLS_MODE=starttls|tls, SMTP_USER/PASSWORD conforme provedor.
# EMAIL_OUTBOX_KEY: 32 bytes aleatórios em base64; obrigatório em produção.
# BFF_SHARED_SECRET e METRICS_TOKEN: segredos independentes com >=32 caracteres.
# Se configurar BFF_SHARED_SECRET no dev, use o mesmo valor em web/.env.
