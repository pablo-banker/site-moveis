# Copy outside source control to deploy/.env.production (chmod 600).
SITE_HOST=loja.example.com
TLS_EMAIL=infra@example.com
# Two different Postgres roles. TLS root certificate must be recognized in the image.
DATABASE_URL=postgres://forma_runtime:CHANGE_ME@db.example.com:5432/forma?sslmode=verify-full
MIGRATION_DATABASE_URL=postgres://forma_migrator:CHANGE_ME@db.example.com:5432/forma?sslmode=verify-full
RUNTIME_DB_ROLE=forma_runtime
# Generate each secret independently, never reuse the placeholders below.
BFF_SHARED_SECRET=CHANGE_ME
METRICS_TOKEN=CHANGE_ME
# openssl rand -base64 32
EMAIL_OUTBOX_KEY=CHANGE_ME
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=Forma <conta@example.com>

# Backup credentials should have read access, not runtime/migration permissions.
BACKUP_DATABASE_URL=postgres://forma_backup:CHANGE_ME@db.example.com:5432/forma?sslmode=verify-full
BACKUP_AGE_RECIPIENT=age1CHANGE_ME
BACKUP_DIRECTORY_HOST=./backups
