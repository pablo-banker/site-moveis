# Backend connection is server-only. No database credentials belong here.
API_URL=http://127.0.0.1:8081
CATALOG_SOURCE=api
# To review the frontend without the API: CATALOG_SOURCE=demo

APP_ENV=development
# Production requires APP_ENV=production and SITE_ORIGIN=https://your-domain
# Configure the deployment adapter ORIGIN to the same HTTPS origin.

# BFF_SHARED_SECRET deve coincidir com a API; obrigatório em produção.
# Consulte deploy/.env.production.example e docs/publication.md.
